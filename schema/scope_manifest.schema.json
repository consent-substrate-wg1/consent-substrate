{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://your-org.example/schemas/scope-manifest-1.0.json",
  "title": "Agent Scope Manifest v1.0",
  "description": "Signed rules of engagement for autonomous agents. Fail-closed: anything not described here is denied.",
  "type": "object",
  "required": [
    "manifest_version",
    "manifest_id",
    "issuer",
    "subject",
    "validity",
    "targets",
    "rules_of_engagement",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 8
    },
    "issuer": {
      "type": "object",
      "required": [
        "org",
        "contact"
      ],
      "additionalProperties": false,
      "properties": {
        "org": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        }
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "agent_id"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        }
      }
    },
    "validity": {
      "type": "object",
      "required": [
        "not_before",
        "not_after"
      ],
      "additionalProperties": false,
      "properties": {
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "not_after": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "rules_of_engagement": {
      "$ref": "#/$defs/roe"
    },
    "bug_bounty": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "program_id": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "policy_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "type",
        "value",
        "allowed_actions"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "domain",
            "url_prefix",
            "ip_cidr",
            "app_package"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "read_public",
              "probe",
              "fingerprint",
              "api_discovery",
              "authenticated_scan",
              "injection_test",
              "exploit_poc"
            ]
          }
        },
        "include_subdomains": {
          "type": "boolean"
        },
        "poc_consent": {
          "type": "boolean"
        },
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests_per_minute": {
              "type": "integer",
              "minimum": 1
            },
            "max_concurrent": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "roe": {
      "type": "object",
      "required": [
        "forbidden_actions"
      ],
      "additionalProperties": false,
      "properties": {
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_concurrent": {
          "type": "integer",
          "minimum": 1
        },
        "quiet_hours": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "tz": {
              "type": "string",
              "default": "UTC"
            }
          }
        },
        "data_handling": {
          "enum": [
            "metadata_only",
            "evidence_hashed",
            "full_capture"
          ]
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0
        },
        "escalation_contact": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "key_id",
        "sig"
      ],
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        }
      }
    }
  }
}